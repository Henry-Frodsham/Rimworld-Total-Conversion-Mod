<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- MaxTac's AV: the vanilla Royalty shuttle with its own art (Textures/Things/RimPunk/Vehicles/MaxTacShuttle).
       Used by CallMaxTac (MaxTac.cs). Same landing box as Trauma Team (MapComponent_TraumaZone). -->

  <ThingDef ParentName="ShuttleBase">
    <defName>RPC_MaxTacShuttle</defName>
    <label>MaxTac AV</label>
    <description>An NCPD MaxTac aerodyne. If it is landing near you, someone has already died.</description>
    <graphicData>
      <texPath>Things/RimPunk/Vehicles/MaxTacShuttle/MaxTacShuttle</texPath>
      <color>(255,255,255)</color>
    </graphicData>
    <forceDebugSpawnable>false</forceDebugSpawnable>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>RPC_MaxTacShuttleIncoming</defName>
    <label>MaxTac AV (incoming)</label>
    <thingClass>ShuttleIncoming</thingClass>
    <graphicData>
      <texPath>Things/RimPunk/Vehicles/MaxTacShuttle/MaxTacShuttle</texPath>
      <color>(255,255,255)</color>
    </graphicData>
    <skyfaller>
      <anticipationSound>RPC_MT_ShuttleLanding</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <angleCurve>
        <points>
          <li>(0,-60)</li>
          <li>(1,-90)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>RPC_MaxTacShuttleLeaving</defName>
    <label>MaxTac AV (leaving)</label>
    <thingClass>FlyShipLeaving</thingClass>
    <graphicData>
      <texPath>Things/RimPunk/Vehicles/MaxTacShuttle/MaxTacShuttle</texPath>
      <color>(255,255,255)</color>
    </graphicData>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>RPC_MT_ShuttleLeaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(5.5,3.5)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <angleCurve>
        <points>
          <li>(0,90)</li>
          <li>(1,70)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.08,2)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <TransportShipDef>
    <defName>RPC_Ship_MaxTacShuttle</defName>
    <label>MaxTac AV</label>
    <shipThing>RPC_MaxTacShuttle</shipThing>
    <arrivingSkyfaller>RPC_MaxTacShuttleIncoming</arrivingSkyfaller>
    <leavingSkyfaller>RPC_MaxTacShuttleLeaving</leavingSkyfaller>
    <worldObject>TravelingShuttle</worldObject>
    <maxLaunchDistance>70</maxLaunchDistance>
  </TransportShipDef>

</Defs>
