  <!-- ===================== backstories (original text) =====================
       categories: RPC_Corpo, RPC_StreetKid, RPC_Nomad. Faction pawns also draw from vanilla categories. -->

  <BackstoryDef>
    <defName>RPC_Child_CorpBrat</defName>
    <title>arcology kid</title>
    <titleShort>arco kid</titleShort>
    <description>[PAWN_nameDef] grew up in a sealed corporate arcology, where the air was filtered, the schools were company-run and every friendship was a future contact.</description>
    <slot>Childhood</slot>
    <spawnCategories><li>RPC_Corpo</li></spawnCategories>
    <skillGains><Social>3</Social><Intellectual>2</Intellectual></skillGains>
  </BackstoryDef>

  <BackstoryDef>
    <defName>RPC_Child_CompanyScholar</defName>
    <title>scholarship kid</title>
    <titleShort>scholar</titleShort>
    <description>A corporate scholarship pulled [PAWN_nameDef] out of the suburbs at age nine. [PAWN_pronoun] spent the rest of [PAWN_possessive] childhood proving [PAWN_pronoun] deserved it.</description>
    <slot>Childhood</slot>
    <spawnCategories><li>RPC_Corpo</li></spawnCategories>
    <skillGains><Intellectual>3</Intellectual><Crafting>1</Crafting></skillGains>
  </BackstoryDef>

  <BackstoryDef>
    <defName>RPC_Child_SecurityBrat</defName>
    <title>security family kid</title>
    <titleShort>sec kid</titleShort>
    <description>Both of [PAWN_nameDef]'s parents worked corporate security. [PAWN_pronoun] learned to strip a pistol before [PAWN_pronoun] learned to ride a bike.</description>
    <slot>Childhood</slot>
    <spawnCategories><li>RPC_Corpo</li></spawnCategories>
    <skillGains><Shooting>3</Shooting><Melee>1</Melee></skillGains>
  </BackstoryDef>

