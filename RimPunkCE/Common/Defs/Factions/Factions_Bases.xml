<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hand-written faction bases. Per-faction defs are generated by Source/Tools/gen_factions.py. -->

  <PawnKindDef Name="RPC_PawnKindBase" Abstract="True">
    <race>Human</race>
    <chemicalAddictionChance>0.05</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <itemQuality>Normal</itemQuality>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <maxGenerationAge>60</maxGenerationAge>
    <combatEnhancingDrugsChance>0.1</combatEnhancingDrugsChance>
    <combatEnhancingDrugsCount>0~2</combatEnhancingDrugsCount>
    <techHediffsChance>0</techHediffsChance>
    <gearHealthRange>0.6~1.2</gearHealthRange>
    <apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>8~14</initialResistanceRange>
  </PawnKindDef>

  <ThingSetMakerDef>
    <defName>RPC_RaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>ComponentIndustrial</li>
            <li>ComponentSpacer</li>
            <li>MedicineIndustrial</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

  <!-- ===================== Trauma Team ===================== -->

  <RimPunkCE.TraumaTeamTuningDef>
    <defName>RPC_TraumaTeamTuning</defName>
    <coverageCostSilver>600</coverageCostSilver>
    <coverageDays>15</coverageDays>
    <squadSize>3~4</squadSize>
    <operatorKind>RPC_TraumaTeam_Operator</operatorKind>
    <clearRadius>18</clearRadius>
    <maxTicksOnGround>5000</maxTicksOnGround>
    <minTicksOnGround>0</minTicksOnGround>
    <returnTicks>60000</returnTicks>
    <maxCarryTicks>2500</maxCarryTicks>
    <maxBoardTicks>1500</maxBoardTicks>
    <!-- billing: every extraction is billed when the patient comes back, on top of the coverage -->
    <feePerHediff>35</feePerHediff>
    <maxTreatmentFee>1200</maxTreatmentFee>
    <combatFee>300</combatFee>
    <combatFeePerHostile>75</combatFeePerHostile>
    <cyberpsychosisFee>2500</cyberpsychosisFee>
    <!-- debt: a bill the colony can't pay. no Trauma Team service until paid; collectors raid after the grace period -->
    <debtDailyInterest>0.02</debtDailyInterest>
    <debtGraceDays>30</debtGraceDays>
    <debtFirstWarningDays>10</debtFirstWarningDays>
    <debtFinalWarningDays>3</debtFinalWarningDays>
    <minPaymentFraction>0.25</minPaymentFraction>
    <collectionRepeatDays>15</collectionRepeatDays>
    <collectionPointsFactor>1.25</collectionPointsFactor>
    <collectionMinPoints>400</collectionMinPoints>
    <!-- NPC clients: rare, high-value corporation / NetWatch pawns only (never gangs). squad fights for the client's faction -->
    <npcLeaderChance>0.2</npcLeaderChance>
    <npcEliteChance>0.04</npcEliteChance>
    <npcEliteMinCombatPower>150</npcEliteMinCombatPower>
    <npcMaxConcurrentDispatches>1</npcMaxConcurrentDispatches>
    <!-- attacking Trauma Team on purpose: hostile this many days -->
    <hostilityDays>30</hostilityDays>
    <!-- max share of one raid that is covered, rounded down (3%: none under 34 raiders) -->
    <npcRaidMaxCoveredFraction>0.03</npcRaidMaxCoveredFraction>
  </RimPunkCE.TraumaTeamTuningDef>

  <JobDef>
    <defName>RPC_TraumaBoardShuttle</defName>
    <driverClass>RimPunkCE.JobDriver_TraumaBoardShuttle</driverClass>
    <reportString>boarding the shuttle.</reportString>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <HediffDef>
    <defName>RPC_TraumaTeamCoverage</defName>
    <label>trauma team coverage</label>
    <description>Covered by Trauma Team International. If this pawn goes down, a Trauma Team shuttle lands a squad that fights off whoever is threatening them, extracts them and brings them back patched up about a day later. Coverage is used up by one dispatch.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.3, 0.9, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ===================== incidents ===================== -->

  <IncidentDef>
    <defName>RPC_NetWatchHunt</defName>
    <label>NetWatch hunt</label>
    <category>ThreatBig</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>RimPunkCE.IncidentWorker_NetWatchHunt</workerClass>
    <baseChance>1.5</baseChance>
    <minRefireDays>12</minRefireDays>
    <pointsScaleable>true</pointsScaleable>
    <tale>Raid</tale>
  </IncidentDef>

  <IncidentDef>
    <defName>RPC_RogueCyberpsycho</defName>
    <label>rogue cyberpsycho</label>
    <category>ThreatBig</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>RimPunkCE.IncidentWorker_RogueCyberpsycho</workerClass>
    <pawnKind>RPC_RogueCyberpsycho</pawnKind>
    <baseChance>0.4</baseChance>
    <minRefireDays>30</minRefireDays>
    <earliestDay>20</earliestDay>
    <minThreatPoints>800</minThreatPoints>
  </IncidentDef>

  <PawnKindDef ParentName="RPC_PawnKindBase">
    <defName>RPC_RogueCyberpsycho</defName>
    <label>rogue cyberpsycho</label>
    <combatPower>400</combatPower>
    <itemQuality>Good</itemQuality>
    <apparelTags><li>IndustrialMilitaryAdvanced</li><li>IndustrialMilitaryBasic</li></apparelTags>
    <apparelMoney>1500~2500</apparelMoney>
    <weaponMoney>500~2500</weaponMoney>
    <weaponTags><li>RPC_Melee</li><li>RPC_Type_power</li></weaponTags>
    <modExtensions>
      <li Class="RimPunkCE.CyberwareLoadoutExtension">
        <minTier>T4</minTier>
        <maxTier>Iconic</maxTier>
        <!-- gonk body: the chrome always overloads them, so the episode never ends on its own -->
        <forceAptitudeDegree>-2</forceAptitudeDegree>
        <options>
          <li><chance>1</chance><hediffs><li>RPC_MooreTechBerserk</li><li>RPC_DynalarSandevistan</li></hediffs></li>
          <li><chance>1</chance><count>2</count><hediffs><li>RPC_GorillaArms</li><li>RPC_MantisBlades</li></hediffs></li>
          <li><chance>1</chance><count>3</count><hediffs><li>RPC_NewtonModule</li><li>RPC_RamUpgrade</li></hediffs></li>
          <li><chance>1</chance><hediffs><li>RPC_SmartLink</li></hediffs></li>
          <li><chance>1</chance><hediffs><li>RPC_TitaniumBones</li></hediffs></li>
          <li><chance>1</chance><count>2</count><hediffs><li>RPC_SubdermalArmor</li><li>RPC_Carapace</li><li>RPC_Chitin</li></hediffs></li>
        </options>
        <extraHediffs><li>RPC_ScrapPlating</li></extraHediffs>
      </li>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount><min>3</min><max>6</max></primaryMagazineCount>
      </li>
    </modExtensions>
  </PawnKindDef>

