<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <StatCategoryDef>
    <defName>RPC_Cyberware</defName>
    <label>Cyberware</label>
    <displayOrder>45</displayOrder>
  </StatCategoryDef>

  <StatDef Name="RPC_PawnStatBase" Abstract="True">
    <category>RPC_Cyberware</category>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <showOnEntities>false</showOnEntities>
    <showOnDrones>false</showOnDrones>
  </StatDef>

  <!-- ===== capacity / cyberware ===== -->

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_CyberwareCapacity</defName>
    <label>cyberware capacity</label>
    <description>How much cyberware this pawn can carry. Using 80% or more risks cyberpsychosis. Every pawn rolls a base of 50-150, then their aptitude trait and some cyberware change it.</description>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>1</minValue>
    <toStringStyle>Integer</toStringStyle>
    <displayPriorityInCategory>100</displayPriorityInCategory>
    <parts>
      <li Class="RimPunkCE.StatPart_CyberwareCapacity">
        <gonkCapacity>20</gonkCapacity>
      </li>
    </parts>
  </StatDef>

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_CyberwareDamageFactor</defName>
    <label>cyberware damage factor</label>
    <description>Multiplier on damage done by cyberware abilities.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <displayPriorityInCategory>90</displayPriorityInCategory>
  </StatDef>

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_CyberwareCooldownFactor</defName>
    <label>cyberware cooldown factor</label>
    <description>Multiplier on cyberware ability cooldowns. Lower is better.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <displayPriorityInCategory>89</displayPriorityInCategory>
  </StatDef>

  <!-- ===== RAM / quickhacks ===== -->

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_RamMax</defName>
    <label>max RAM</label>
    <description>RAM available to a cyberdeck for quickhacks. Only cyberdecks give a base amount.</description>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>FloatOne</toStringStyle>
    <hideAtValue>0</hideAtValue>
    <displayPriorityInCategory>80</displayPriorityInCategory>
  </StatDef>

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_RamRegen</defName>
    <label>RAM regeneration</label>
    <description>RAM recovered per second.</description>
    <defaultBaseValue>0.5</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>FloatTwo</toStringStyle>
    <formatString>{0}/s</formatString>
    <showOnDefaultValue>false</showOnDefaultValue>
    <displayPriorityInCategory>79</displayPriorityInCategory>
  </StatDef>

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_QuickhackUploadSpeed</defName>
    <label>quickhack upload speed</label>
    <description>How fast quickhacks upload to their target.</description>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <displayPriorityInCategory>78</displayPriorityInCategory>
  </StatDef>

  <StatDef ParentName="RPC_PawnStatBase">
    <defName>RPC_QuickhackCritChance</defName>
