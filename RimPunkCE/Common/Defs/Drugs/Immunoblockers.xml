  <!-- ================= special: David's last stand ================= -->

  <ThingDef ParentName="RPC_ImmunoblockerBase">
    <defName>RPC_Immunoblocker_DavidsLastStand</defName>
    <label>David's last stand</label>
    <description>Everything at once, straight into the vein. Adds 1000 cyberware capacity for 6 hours, and the moment it wears off the user goes cyberpsycho for good, with twice the strength of a normal break. Nothing prevents it and nothing ends it.</description>
    <descriptionHyperlinks><HediffDef>RPC_ImmunoblockerHigh_DavidsLastStand</HediffDef></descriptionHyperlinks>
    <graphicData>
      <texPath>Things/RimPunk/Drugs/DavidsLastStand</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>900</WorkToMake>
      <MarketValue>200</MarketValue>
    </statBases>
    <ingestible>
      <ingestSound>Ingest_Inject</ingestSound>
      <ingestCommandString>Inject {0}</ingestCommandString>
      <ingestReportString>Injecting {0}.</ingestReportString>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>RPC_ImmunoblockerHigh_DavidsLastStand</hediffDef>
          <severity>1</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>RPC_DavidsLastStand</researchPrerequisite>
      <productCount>1</productCount>
      <displayPriority>2205</displayPriority>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>1105</listOrder>
      </li>
    </comps>
  </ThingDef>

  <HediffDef ParentName="RPC_ImmunoblockerHediffBase">
    <defName>RPC_ImmunoblockerHigh_DavidsLastStand</defName>
    <label>David's last stand</label>
    <description>The body has stopped rejecting anything, adding 1000 cyberware capacity. When this wears off, chrome instability rises sharply.</description>
    <defaultLabelColor>(1, 0.2, 0.35)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimPunkCE.ImmunoblockerExtension">
        <capacityBonus>1000</capacityBonus>
        <psychosisOnEnd>true</psychosisOnEnd>
      </li>
    </modExtensions>
  </HediffDef>

