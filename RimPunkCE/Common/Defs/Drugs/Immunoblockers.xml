<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Temporary cyberware capacity (Source/RimPunkCE/Psychosis/Immunoblockers.cs). Weak lasts long, strong burns fast.
       Only the strongest active blocker counts; a second dose of the same one restarts its clock.
       The only thing that raises a gonk's capacity. All recipes take wake-up's work (900).

       drug                 capacity  lasts  batch (20 neutroamine)
       basewatch               +20     14d    10
       bethaloperidol          +50      7d     8
       prime time              +90      4d     6
       surge                  +140      2d     4
       black lace             +200      1d     2
       David's last stand    +1000      6h     1   (own research; instability spike on expiry) -->

  <!-- ================= research (second row of the cyberware tab) ================= -->

  <ResearchProjectDef ParentName="RPC_CyberwareResearchBase">
    <defName>RPC_Immunoblockers</defName>
    <label>immunoblockers</label>
    <description>Suppress the body's rejection of chrome. Synthesize immunoblockers at a drug lab: temporary cyberware capacity, stronger doses wearing off sooner.</description>
    <baseCost>1000</baseCost>
    <prerequisites>
      <li>MicroelectronicsBasics</li>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>0</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="RPC_CyberwareResearchBase">
    <defName>RPC_DavidsLastStand</defName>
    <label>David's last stand</label>
    <description>An immunoblocker pushed far past any safe dose. Six hours of carrying more chrome than a body should survive, then an instability spike.</description>
    <baseCost>2000</baseCost>
    <prerequisites>
      <li>RPC_Immunoblockers</li>
    </prerequisites>
    <researchViewX>1</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <!-- ================= bases ================= -->

  <ThingDef Name="RPC_ImmunoblockerBase" ParentName="MakeableDrugPillBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <socialPropernessMatters>false</socialPropernessMatters>
    <techLevel>Spacer</techLevel>
    <statBases>
      <Mass>0.005</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <ingestible>
      <drugCategory>Medical</drugCategory>
    </ingestible>
    <recipeMaker>
      <!-- MakeableDrugBase adds a x4 bulk recipe; a batch here is exactly productCount -->
      <bulkRecipeCount>-1</bulkRecipeCount>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <soundWorking>Recipe_Drug</soundWorking>
    </recipeMaker>
    <costList>
      <Neutroamine>20</Neutroamine>
    </costList>
  </ThingDef>

  <HediffDef Name="RPC_ImmunoblockerHediffBase" Abstract="True">
    <hediffClass>RimPunkCE.Hediff_Immunoblocker</hediffClass>
    <defaultLabelColor>(0.4, 0.9, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <maxSeverity>1</maxSeverity>
  </HediffDef>

  <!-- ================= tier 1: basewatch ================= -->

  <ThingDef ParentName="RPC_ImmunoblockerBase">
    <defName>RPC_Immunoblocker_Basewatch</defName>
    <label>basewatch</label>
    <description>A low-dose maintenance immunoblocker. Adds 20 cyberware capacity for 14 days. Only the strongest active immunoblocker counts.</description>
    <descriptionHyperlinks><HediffDef>RPC_ImmunoblockerHigh_Basewatch</HediffDef></descriptionHyperlinks>
    <graphicData>
      <texPath>Things/RimPunk/Drugs/Basewatch</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>900</WorkToMake>
      <MarketValue>18</MarketValue>
    </statBases>
    <ingestible>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>RPC_ImmunoblockerHigh_Basewatch</hediffDef>
          <severity>1</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>RPC_Immunoblockers</researchPrerequisite>
      <label>make basewatch x10</label>
      <productCount>10</productCount>
      <displayPriority>2200</displayPriority>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>1100</listOrder>
      </li>
    </comps>
  </ThingDef>

  <HediffDef ParentName="RPC_ImmunoblockerHediffBase">
    <defName>RPC_ImmunoblockerHigh_Basewatch</defName>
    <label>basewatch</label>
    <description>Low-dose immunoblockers in the bloodstream, adding 20 cyberware capacity.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>840000~840000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimPunkCE.ImmunoblockerExtension">
        <capacityBonus>20</capacityBonus>
      </li>
    </modExtensions>
  </HediffDef>

