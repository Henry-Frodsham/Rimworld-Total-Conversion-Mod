<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- normal traders: T1-T2 cyberware with capacity cost 0-20 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName!="Orbital_Exotic" and defName!="Caravan_Outlander_Exotic"]/stockGenerators</xpath>
    <value>
      <li Class="RimPunkCE.StockGenerator_Cyberware">
        <countRange>0~2</countRange>
        <minTier>T1</minTier>
        <maxTier>T2</maxTier>
        <maxCapacityCost>20</maxCapacityCost>
      </li>
    </value>
  </Operation>

  <!-- exotic traders: the good chrome, T3-Iconic, any capacity -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="Orbital_Exotic" or defName="Caravan_Outlander_Exotic"]/stockGenerators</xpath>
    <value>
      <li Class="RimPunkCE.StockGenerator_Cyberware">
        <countRange>2~4</countRange>
        <minTier>T3</minTier>
        <maxTier>Iconic</maxTier>
      </li>
      <!-- neural shards (cycle 4, gen_shards.py): skill and capacity shards, now and then the soulkiller -->
      <li Class="RimPunkCE.StockGenerator_Shard">
        <countRange>1~3</countRange>
        <soulkillerChance>0.12</soulkillerChance>
      </li>
      <!-- engrams of lore figures: rarely -->
      <li Class="RimPunkCE.StockGenerator_Engram">
        <chance>0.12</chance>
      </li>
      <!-- quickhack shards (gen_quickhacks.py) -->
      <li Class="StockGenerator_Tag">
        <tradeTag>RPC_QuickhackShard</tradeTag>
        <thingDefCountRange>2~4</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
    </value>
  </Operation>

</Patch>
